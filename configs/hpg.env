# Sourceable cluster defaults. Every value can be overridden before sbatch.
: "${PROJECT_ROOT:=/blue/fsu-compsci-dept/xc25.fsu/hq/ICML27_agent_distillation}"
: "${ALFWORLD_DATA_ROOT:=/blue/fsu-compsci-dept/xc25.fsu/hq/tc-alignment-vllm/envs/alfworld/data/json_2.1.1}"
: "${HF_HOME:=/blue/fsu-compsci-dept/xc25.fsu/hq/tools/hf-cache}"
: "${VLLM_PYTHON:=/blue/fsu-compsci-dept/xc25.fsu/hq/tc-alignment-vllm/envs/vllm-serve/.venv/bin/python}"
: "${ENV_PYTHON:=${PROJECT_ROOT}/.venv/bin/python}"
: "${MODEL_PATH:=${HF_HOME}/hub/models--google--gemma-4-12B-it/snapshots/707f0a3b8a3c7ad586ed01e27eafbad8a27dd0f7}"
: "${ENABLE_THINKING:=off}"
: "${TASKS:=${PROJECT_ROOT}/data/manifest/dev40.json}"
: "${OUT:=${PROJECT_ROOT}/reports/runs/base-dev40-thinking-${ENABLE_THINKING}-${SLURM_JOB_ID:-manual}}"
: "${WORKERS:=8}"
: "${MAX_TOKENS:=1024}"
: "${READY_TIMEOUT:=900}"
export PROJECT_ROOT ALFWORLD_DATA_ROOT HF_HOME VLLM_PYTHON ENV_PYTHON MODEL_PATH ENABLE_THINKING TASKS OUT
export WORKERS MAX_TOKENS READY_TIMEOUT

# Stage 2b: installed HPG runtime, no installation/download inside jobs.
# HPG: torch 2.11.0+cu128, transformers 5.14.1, peft 0.20.0, accelerate 1.14.0.
# RAI CPU reference: torch 2.13.0+cu130, same transformers/peft/accelerate.
: "${TRAIN_PYTHON:=/blue/fsu-compsci-dept/xc25.fsu/hq/tc-alignment/.venv/bin/python}"
: "${RAI_REFERENCE_PYTHON:=/home/xueqi/hq/projects/tc-alignment-taskeq/.venv/bin/python}"
: "${VERIFIED:=${PROJECT_ROOT}/data/verified/seeds_k10_s0}"
: "${TRAIN_OUT:=${PROJECT_ROOT}/reports/runs/seed-sft-${SLURM_JOB_ID:-manual}}"
: "${TRAIN_PASSES:=3}"
: "${TRAIN_TOKENS:=}"
: "${CHECKPOINT_TOKENS:=}"
: "${TOKENS_PER_UPDATE:=512}"
: "${LEARNING_RATE:=1e-5}"
: "${TRAIN_SEED:=0}"
: "${MAX_LENGTH:=32768}"
export TRAIN_PYTHON RAI_REFERENCE_PYTHON VERIFIED TRAIN_OUT TRAIN_PASSES TRAIN_TOKENS
export CHECKPOINT_TOKENS TOKENS_PER_UPDATE LEARNING_RATE TRAIN_SEED MAX_LENGTH
